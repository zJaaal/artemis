{
  "name": "@zjaaal/artemis",
  "version": "0.1.0",
  "description": "Drop one file in a folder and get a CLI command. A command framework agents can write and read.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "art": "dist/cli/main.js",
    "artemis": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worktrees": {
      "types": "./dist/kits/worktrees/index.d.ts",
      "import": "./dist/kits/worktrees/index.js"
    },
    "./terminal": {
      "types": "./dist/kits/terminal/index.d.ts",
      "import": "./dist/kits/terminal/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zJaaal/artemis.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:all": "tsc --noEmit && eslint . && prettier --check . && vitest run",
    "check-exports": "node scripts/check-exports.mjs",
    "check-lock": "node scripts/check-lock.mjs",
    "check-bin": "node scripts/check-bin.mjs"
  },
  "dependencies": {
    "prompts": "2.4.2"
  },
  "peerDependencies": {
    "@types/prompts": "^2.4.9"
  },
  "peerDependenciesMeta": {
    "@types/prompts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/prompts": "2.4.9",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
